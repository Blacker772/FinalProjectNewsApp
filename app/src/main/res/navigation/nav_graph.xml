<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/newsFragment">

    <fragment
        android:id="@+id/newsFragment"
        android:name="com.example.newsaz.ui.news.NewsFragment"
        android:label="fragment_news"
        tools:layout="@layout/fragment_news">

        <action
            android:id="@+id/action_newsFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_newsFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />

    </fragment>

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.newsaz.ui.details.DetailsFragment"
        android:label="fragment_details"
        tools:layout="@layout/fragment_details">

        <argument
            android:name="news"
            app:argType="com.example.newsaz.data.model.newsmodel.NewsListModel"
            app:nullable="true"
            android:defaultValue="@null"/>
        <action
            android:id="@+id/action_detailsFragment_to_otherFragment"
            app:destination="@id/otherFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.newsaz.ui.search.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/otherFragment"
        android:name="com.example.newsaz.ui.details.other.OtherFragment"
        android:label="OtherFragment"
        tools:layout="@layout/fragment_other">

        <argument
            android:name="news"
            app:argType="com.example.newsaz.data.model.newsmodel.NewsListModel"
            app:nullable="true"
            android:defaultValue="@null"/>
    </fragment>

</navigation>